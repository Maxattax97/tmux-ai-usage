#!/bin/sh

set -eu

CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/tmux-ai-usage
CACHE_FILE=$CACHE_DIR/tmux-ai-usage-claude-rate-limits.txt
MIN_UPDATE_SECONDS=30
mkdir -p "$CACHE_DIR"

input=$(cat)

extract_claude_used_percentage() {
    printf '%s\n' "$input" | awk '
        {
            idx = index($0, "\"five_hour\"")
            if (idx == 0) {
                next
            }

            rest = substr($0, idx)
            key = "\"used_percentage\""
            key_idx = index(rest, key)
            if (key_idx == 0) {
                next
            }

            rest = substr(rest, key_idx + length(key))
            sub(/^[^:]*:[[:space:]]*/, "", rest)

            if (match(rest, /^-?[0-9]+([.][0-9]+)?/)) {
                print substr(rest, RSTART, RLENGTH)
                exit
            }
        }
    '
}

get_mtime() {
    path=$1

    stat -f %m "$path" 2>/dev/null || stat -c %Y "$path" 2>/dev/null || printf '0\n'
}

if [ -f "$CACHE_FILE" ]; then
    now=$(date +%s)
    mtime=$(get_mtime "$CACHE_FILE")
    age=$((now - mtime))

    if [ "$age" -lt "$MIN_UPDATE_SECONDS" ]; then
        exit 0
    fi
fi

tmp_file=$(mktemp "$CACHE_DIR/tmux-ai-usage-claude-rate-limits.tmp.XXXXXX")
trap 'rm -f "$tmp_file"' EXIT HUP INT TERM

used_percentage=$(extract_claude_used_percentage)

if [ -n "$used_percentage" ]; then
    remaining_percentage=$(awk -v used="$used_percentage" 'BEGIN { printf "%d\n", 100 - used }')

    {
        printf 'available=true\n'
        printf 'used_percentage=%s\n' "$used_percentage"
        printf 'remaining_percentage=%s\n' "$remaining_percentage"
    } > "$tmp_file"
elif [ ! -f "$CACHE_FILE" ]; then
    {
        printf 'available=false\n'
        printf 'used_percentage=\n'
        printf 'remaining_percentage=\n'
    } > "$tmp_file"
else
    exit 0
fi

mv "$tmp_file" "$CACHE_FILE"
trap - EXIT HUP INT TERM
